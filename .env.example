# Folio3 Task Management App — environment configuration
# Copy to .env.local and fill in real values. NEVER commit real secrets.

# Supabase project (public — safe in the client; RLS is the security boundary)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The only Google Workspace domain allowed to sign in
FOLIO3_GOOGLE_DOMAIN=folio3.com

# Canonical site URL for the current environment (redirects, links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
